{
  "name": "african-proverbs-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "check-types": "prisma generate && tsc --noEmit",
    "lint": "pnpm check-types",
    "test": "node --experimental-strip-types --test lib/*.test.ts",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "db:migrations:apply": "wrangler d1 migrations apply african-proverbs --remote",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.5.1",
    "@fortawesome/free-brands-svg-icons": "^6.5.1",
    "@fortawesome/pro-duotone-svg-icons": "^6.5.1",
    "@fortawesome/pro-light-svg-icons": "^6.5.1",
    "@fortawesome/pro-regular-svg-icons": "^6.5.1",
    "@fortawesome/pro-solid-svg-icons": "^6.5.1",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@opennextjs/cloudflare": "1.20.1",
    "@prisma/adapter-d1": "7.8.0",
    "@prisma/client": "7.8.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-aspect-ratio": "^1.2.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.577.0",
    "next": "16.2.10",
    "next-auth": "5.0.0-beta.32",
    "next-plausible": "^3.12.5",
    "openai": "^6.48.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@prisma/adapter-better-sqlite3": "7.8.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.11.25",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.0.1",
    "better-sqlite3": "^12.11.1",
    "pg": "^8.16.3",
    "postcss": "^8",
    "prisma": "7.8.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^6.0.3",
    "wrangler": "4.151.3"
  },
  "packageManager": "pnpm@10.25.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "prisma",
      "@prisma/engines",
      "sharp",
      "workerd"
    ]
  }
}
