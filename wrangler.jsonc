{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "african-proverbs-web",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_next/static/*", "!/images/*", "!/*.svg", "!/*.ico"]
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "african-proverbs-web" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "african-proverbs",
      "database_id": "210fa6ee-d95d-4453-8e70-541ae0023803",
      "migrations_dir": "migrations"
    }
  ],
  // Secrets (wrangler secret): OPENAI_API_KEY, GITHUB_ID, GITHUB_SECRET, AUTH_SECRET.
  // Source: 1Password "African Proverbs Web Prod".
  "vars": {
    "CF_WEB_ANALYTICS_TOKEN": "1fa460baf2fe4917b8ddc5b390ef6da2"
  }
}
